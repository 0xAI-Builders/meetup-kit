# Dirección pública, sin diagonal final. Se usa en las ligas, el QR y el .ics.
BASE_URL=https://meetups.ejemplo.com
# Subruta si la app vive bajo una ruta del dominio (por ejemplo /meetup-generator). Vacío = raíz.
# Si la usas, BASE_URL debe terminar en ella: https://ejemplo.com/meetup-generator
BASE_PATH=
# Sal para contar visitantes únicos sin guardar IPs. Pon una cadena larga y aleatoria y no la cambies.
SALT=
# Código que se pide al crear un meetup. Vacío = cualquiera puede crear.
CREATE_CODE=
# 1 si corre detrás de nginx u otro proxy que manda X-Real-IP.
TRUST_PROXY=1
# Zona horaria por omisión del formulario.
DEFAULT_TZ=America/Mexico_City
# Puerto en el host (docker compose). Dentro del contenedor siempre es 7343.
HOST_PORT=7343
# Destinos de los pasos de Avalanche (opcionales).
# CASCADE_URL=https://cascade.team1.network/?ref=t1-latam
# BUILDERHUB_URL=https://build.avax.network/login
# CORE_URL=https://core.app/
