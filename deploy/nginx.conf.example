# /etc/nginx/sites-available/meetups.ejemplo.com
# Después: ln -s ../sites-available/meetups.ejemplo.com /etc/nginx/sites-enabled/ && nginx -t && systemctl reload nginx
# TLS: certbot --nginx -d meetups.ejemplo.com
server {
    listen 80;
    server_name meetups.ejemplo.com;
    client_max_body_size 5m;

    location / {
        proxy_pass http://127.0.0.1:7343;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}
